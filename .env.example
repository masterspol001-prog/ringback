# RingBack environment configuration
# Copy to .env and fill in what you need. Never commit real values.

# --- server ---
PORT=4000
# Bind address. Leave as 127.0.0.1 locally; set 0.0.0.0 in a container.
HOST=127.0.0.1
# Optional: allow machine access to the CRM via ?token=... or Authorization: Bearer
ADMIN_TOKEN=

# --- admin login (strongly recommended before deploying) ---
# Creating the first admin turns on auth for the CRM. Passwords: 8+ characters.
RB_ADMIN_EMAIL=
RB_ADMIN_PASSWORD=
# Force auth on/off regardless of whether users exist. "1" = on, "0" = off.
# RB_ENFORCE_AUTH=
# Mark the session cookie Secure (set to 1 when serving over HTTPS).
RB_SECURE_COOKIES=
# Session lifetime in days (default 7).
RB_SESSION_DAYS=7

# --- payments (RingBack never processes cards; it uses your own links) ---
# Any one of these enables checkout. The most specific match wins.
# Visiting /pay/success is NOT a paid conversion. Record paid on the dashboard.
RB_PAYMENT_LINK=
RB_PAYMENT_LINK_STARTER=
RB_PAYMENT_LINK_PROFESSIONAL=
RB_PAYMENT_LINK_BUSINESS=
RB_PAYPAL_ME=
# e.g. https://razorpay.me/@yourhandle — used for every plan when set
RB_RAZORPAY_LINK=
RB_STRIPE_LINK=
# Optional: "test" or "live". If unset, test/sandbox URLs are detected as test.
RB_BILLING_MODE=
# Public origin used only to advertise /pay/success and /pay/cancel. Never invents a host.
RB_PUBLIC_URL=

# --- outbound SMS (optional; simulated when unset) ---
# Without these, SMS is recorded as simulated. Health will never claim LIVE.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional shared secret for inbound webhook signatures (falls back to TWILIO_AUTH_TOKEN).
# RB_WEBHOOK_SECRET=

# --- AI reply drafting (optional; deterministic engine is used when unset) ---
# You must supply your own key. RingBack never reads platform/runtime credentials.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=
USER_LLM_MODEL=gpt-4o-mini
USER_LLM_TIMEOUT_MS=12000

# --- storage ---
# Where the SQLite database lives. On a server, point this at a mounted volume.
# RINGBACK_DATA_DIR=./data
# RINGBACK_DB=./data/ringback.db
